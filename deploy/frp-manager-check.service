[Unit]
Description=Check for new FRP Manager versions
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 /usr/local/sbin/frp-manager-check-updates
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/frp-manager /var/cache/frp-manager
TimeoutStartSec=130
