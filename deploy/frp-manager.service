[Unit]
Description=FRP Manager API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=frpmanager-svc
Group=frpmanager-svc
WorkingDirectory=/opt/frp-manager
EnvironmentFile=/etc/frp-manager/oidc.env
ExecStart=/opt/frp-manager/venv/bin/uvicorn sso_app:app --host 127.0.0.1 --port 8088 --workers 1 --no-access-log
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/frp-manager
UMask=0077

[Install]
WantedBy=multi-user.target
