[Unit]
Description=FRP Manager opt-in outage alert worker
After=network-online.target frp-manager-health.service
Wants=network-online.target
[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=-/etc/frp-manager/alerts.env
ExecStart=/usr/bin/python3 /usr/local/sbin/frp-manager-alert-worker
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/frp-manager
UMask=0077
TimeoutStartSec=25
