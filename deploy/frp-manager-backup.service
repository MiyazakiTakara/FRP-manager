[Unit]
Description=FRP Manager root-only local config backup
[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 /usr/local/sbin/frp-manager-backup-config
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/backups/frp-manager /var/lib/frp-manager
UMask=0077
TimeoutStartSec=90
