OIDC_ISSUER=https://sso.example.com/realms/example
OIDC_CLIENT_ID=frp-manager
OIDC_CLIENT_SECRET=CHANGE_ME
APP_PUBLIC_URL=https://frp.example.com
SESSION_SECRET=GENERATE_A_LONG_RANDOM_VALUE
FRPS_PUBLIC_HOST=example.com
FRPS_SSH_USER=frpmanager
FRPS_SSH_KEY=/etc/frp-manager/id_ed25519
FRPS_SSH_KNOWN_HOSTS=/etc/frp-manager/ssh/known_hosts
FRPS_STATUS_COMMAND=sudo -n /usr/local/sbin/frp-manager-ovh status
